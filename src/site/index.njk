---
permalink: /
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>jhlj.studio</title>
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        width: 100%;
        height: 100%;
        overflow: hidden;
      }

      nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 1.25rem 2rem;
      }

      .nav-left {
        display: flex;
        gap: 2rem;
      }

      .nav-center {
        font-size: 1rem;
        letter-spacing: 0.05em;
      }

      .nav-right {
        display: flex;
        justify-content: flex-end;
      }

      nav a {
        color: #fff;
        text-decoration: none;
        font-family: sans-serif;
        font-size: 0.85rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        mix-blend-mode: difference;
        opacity: 0.9;
        transition: opacity 0.2s;
      }

      nav a:hover {
        opacity: 1;
      }

      .nav-center a {
        font-size: 1rem;
        text-transform: none;
        letter-spacing: 0.06em;
      }

      .split {
        display: flex;
        width: 100%;
        height: 100%;
      }

      .half {
        flex: 1;
        overflow: hidden;
      }

      .half img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .half-left img {
        object-position: 0% 61%;
        transform: scale(1.9);  /* 1.3 = 20% zoom */
        transform-origin: 0% 61%;
      }

      .half-right img {
        object-position: 50% 40%;
        transform: scale(1.2);  /* 1.3 = 20% zoom */
        transform-origin: center center;
      }
    </style>
  </head>
  <body>
    <nav>
      <div class="nav-left">
        <a href="/projects/">Projects</a>
        <a href="/garden/">Garden</a>
      </div>
      <div class="nav-center">
        <a href="/">jhlj.studio</a>
      </div>
      <div class="nav-right">
        <a href="/contact/">Contact</a>
      </div>
    </nav>

    <div class="split">
      <div class="half half-left">
        <img src="/img/IMG_3366.jpeg" alt="" />
      </div>
      <div class="half half-right">
        <img src="/img/homepage_01.JPG" alt="" />
      </div>
    </div>
  </body>
</html>
